---
import Layout from '../layouts/Layout.astro';
const skills = ['Java 核心编程', 'Spring Boot', 'Spring Cloud Alibaba', 'MySQL', 'Redis', 'RabbitMQ', 'MyBatis-Plus', 'Elasticsearch', 'Docker', 'Linux', 'Jenkins', 'LangChain4j', 'Vue 3', 'Element Plus'];
const experience = [
  { date: '2025.05 - 至今', company: '北京XXX科技有限公司', role: 'Java 开发工程师' },
  { date: '2023.06 - 2025.05', company: '北京XXXX科技有限公司）', role: 'Java 开发工程师' },
  
];
const projectSkills = ['SpringBoot', 'SpringCloud', 'MySQL', 'MyBatis-Plus', 'RabbitMQ', 'Redis', 'Redisson', 'MongoDB', 'OpenFeign', 'Gateway', 'Nacos', 'Elasticsearch', 'Xxl-Job', '腾讯云点播', 'Seata', 'Canal'];
const skillDetails = [
  '熟练掌握 Java 核心编程，在面向对象部分有着深刻理解，了解过一定集合底层源码，代码风格良好。',
  '熟练掌握集合、多线程、异常和常用工具类，熟悉 Lambda 表达式和 Stream 流 API 的使用。',
  '熟练掌握 JUC 多线程并发编程的基本操作，多线程工具类的使用，理解 AQS 和 CAS 的原理及应用。',
  '熟悉 JVM 内存模型及垃圾回收机制，熟悉 Arthas 性能诊断工具。',
  '熟练使用 MySQL 事务隔离级别、MVCC 机制、索引优化，了解 ShardingSphereJDBC 分库分表框架。',
  '熟练使用 Redis 常用数据类型，熟悉缓存击穿、缓存穿透、缓存雪崩、数据一致性等问题及解决方案。',
  '熟悉使用 Redisson 分布式锁，控制强一致并发场景，理解锁原理及应用。使用布隆过滤器构建查询防重。',
  '使用 Canal 实现数据一致性，实时同步 Mysql 数据库变更数据到其他系统，了解 Canal 原理。',
  '熟练掌握 Spring Cloud Alibaba 组件，如 Nacos、Sentinel、Seata 模式分布式事务。',
  '熟练使用 RabbitMQ，熟悉 ACK 确认、持久化机制、延迟队列的应用以及业务处理。',
  '熟练使用 Seata 实现分布式事务，了解 AT/XA 模式原理。',
  '熟悉 SpringBoot、SpringMVC、MyBatisPlus、AOP、声明式事务。',
  '了解全文搜索引擎 Elasticsearch，编写 DSL 语句实现检索。',
  '熟练使用 Git、Maven 等项目管理开发工具。',
  '熟练 Linux、Docker、Jenkins，实现高效持续集成（CI）及持续部署（CD），了解阿里云服务器部署流程。',
  '熟悉 LangChain4J 大模型调度框架，了解流式输出、记忆缓存、向量数据库以及 RAG。',
  '熟悉 HTML、CSS、JS、VUE3、ElementPlus 等技术。'
];
const project = {
  name: '梦梦声波',
  stack: 'SpringBoot、SpringCloud、MySQL、MyBatis-Plus、RabbitMQ、Redis、Redisson、MongoDB、OpenFeign、Gateway、Nacos、ElasticSearch、Xxl-Job、腾讯云点播、Seata、Canal。',
  description: '“梦梦声波”以声音为舟，带用户驶入奇幻梦境。项目融合了多种风格的助眠音频，有轻柔舒缓的古典音乐，搭配细腻的故事讲述，营造出童话般的梦幻场景；也有充满异域风情的旋律，结合自然音效，仿佛置身于神秘的远方。无论是想放松疲惫的身心，还是渴望一场充满想象的梦境冒险，在这里都能找到专属的声音向导，让每一个夜晚都成为一场独特的梦境旅行。',
  responsibilities: ['引入大模型技术，参与部分 AI 声音评析功能的开发，参与需求分析，设计部分接口。', '负责详情模块开发优化：展示专辑详情信息、声音统计信息和对应声音列表，并使用多线程异步编排优化项目，将当前接口在 gps100 时从 500ms 降低到 150ms 左右。', '参与订单模块开发：负责订单结算。', '参与后台模块开发，主要实时记录播放时间及进度，让用户可以无缝衔接声波进度。'],
  skills: ['使用 OpenFeign 进行远程调用，Gateway 作为网关进行请求过滤，Sentinel 进行服务的熔断及降级，Nacos 作为配置中心以及注册中心。', '使用阿里云存储图片信息，使用腾讯云点播存储音频数据，使用数据万象审核声音及专辑名字信息。', '使用 MongoDB 存储历史播放信息，保存声音进度，实现无感续听。', '上架时将专辑名称存入 ES 搜索引擎，实现快速检索。', '使用 Spring 的 TaskExecutor 以及自定义线程池实现并发查询多线程查询提高接口响应速度。', '使用执行计划分析 SQL 语句，通过建立索引，优化语句提升执行效率。', '使用 Xxl-Job 定时过期已过期的 VIP 用户，更新排行榜。', '使用 Redis 对数据进行缓存，使查询的数据优先访问 Redis 而不是 MySQL 提升接口效率，降低数据库压力。', '使用布隆过滤器防止缓存穿透，使用 Redisson 分布式锁解决缓存击穿。', '使用 Seata 解决多个微服务模块互相调用产生的事务问题，并对分布式事务进行监控。', '使用 RabbitMQ 延迟消息以及延迟消息插件实现 10 分钟未支付自动关闭订单功能。'],
  highlights: ['运用策略＋工厂设计模式避免大量 if-else 判断出现，并解决硬编码降低代码侵入性。', '基于自定义注解＋aop＋springEL 表达式完成了可拔插，可通用，可配置的 Redis 缓存组件。', '使用 CompletableFuture 对多模块 OpenFeign 进行异步编排，提升接口查询效率。', '使用 LangChain4j 调用 DeepSeek 大模型，对专辑进行描述以及联想，并使用 OpenAiStreamingChatModel 以流式方式向用户进行输出，提升用户体验。', '为避免出现库存超扣问题，使用 Redisson 分布式锁解决库存超扣问题。', '使用腾讯云点播服务对声音、专辑名称以及图片上进行审核，上架专辑、声音时如消息不通过审核直接拒绝上架，需要人工审核则交给人工复审。']
};
---
<Layout title="扎代｜Java 开发工程师">
  <main class="resume">
    <header class="hero"><div class="hero-main"><p class="eyebrow">JAVA ENGINEER · BACKEND DEVELOPMENT</p><h1>扎代</h1><p class="headline">求职方向：AI 全能开发工程师</p><div class="contact-grid"><span><b>姓名</b> 扎代</span><span><b>电话</b> 18701421535</span><span><b>民族</b> 柯尔克孜</span><span><b>邮箱</b> N2839389096@126.com</span><span><b>年龄</b> 26 岁</span><span><b>微信</b>RDevil07</span></div></div><div class="portrait" aria-label="扎代的个人头像"><img src={`${import.meta.env.BASE_URL}/avatar.jpg`} alt="扎代的个人头像" /></div></header>
    <div class="content">
      <section class="section education"><div class="section-heading"><span>教育背景</span><i></i></div><div class="education-row"><strong>2019.09 - 2023.06</strong><span>新疆农业大学</span></div><p>英语：六级、国家励志奖学金、自治区奖学金、优秀班干部等</p></section>
      <section class="section intent"><div class="section-heading"><span>求职意向</span><i></i></div><div class="intent-grid"><p><b>期望职位：</b>AI Agent 工程师</p><p><b>期望城市：</b>北京</p><p><b>到岗时间：</b>随时到岗</p><p><b>目前状态：</b>离职</p><p><b>期望薪资：</b>面议</p><p><b>工作性质：</b>全职</p></div></section>
      <section class="section"><div class="section-heading"><span>核心技能</span><i></i></div><div class="skill-cloud">{skills.map((skill) => <span>{skill}</span>)}</div><ol class="skill-list">{skillDetails.map((skill) => <li>{skill}</li>)}</ol></section>
      <section class="section project"><div class="section-heading"><span>项目经历</span><i></i></div><div class="project-meta"><span>项目名称：{project.name}</span></div><p class="project-line"><b>技术栈：</b>{project.stack}</p><h3>项目描述：</h3><p class="project-intro">{project.description}</p><h3>项目职责：</h3><ol class="project-list">{project.responsibilities.map((item) => <li>{item}</li>)}</ol><h3>技能描述：</h3><ol class="project-list">{project.skills.map((item) => <li>{item}</li>)}</ol><h3>项目亮点：</h3><ol class="project-list">{project.highlights.map((item) => <li>{item}</li>)}</ol></section>
      <section class="section experience"><div class="section-heading">
		<span>工作经历</span><i></i></div>{experience.map((item) => <div class="experience-row"><strong>{item.date}</strong><span>{item.company}</span><b>{item.role}</b></div>)}</section>
      <section class="section self-evaluation"><div class="section-heading"><span>自我评价</span><i></i></div><div class="evaluation-grid"><p>01 <span>能够高效应对高强度项目任务，保证项目按时高质量交付。</span></p><p>02 <span>善于沟通协作，能快速融入新团队并推动项目高效进行。</span></p><p>03 <span>注重细节，代码规范严谨，具备良好的问题分析与解决能力。</span></p><p>04 <span>持续关注技术发展，主动学习新工具与框架并应用于实际项目。</span></p></div></section>
    </div>
  </main>
</Layout>

<style>
  .resume { width: min(100%, 1080px); margin: 32px auto; background: #fff; box-shadow: 0 20px 60px rgba(24, 40, 64, .12); }
  .hero { min-height: 260px; padding: 42px 58px 38px; display: flex; justify-content: space-between; align-items: center; color: #fff; background: linear-gradient(120deg, #11233d, #1b5373 62%, #2a8b91); position: relative; overflow: hidden; }
  .hero:after { content: ''; position: absolute; width: 420px; height: 420px; border: 1px solid rgba(255,255,255,.14); border-radius: 50%; right: 90px; top: -260px; box-shadow: 0 0 0 32px rgba(255,255,255,.04), 0 0 0 64px rgba(255,255,255,.03); }
  .hero-main { position: relative; z-index: 1; }.eyebrow { color: #8bd6d0; font-size: 11px; letter-spacing: .22em; font-weight: 700; }.hero h1 { font-size: 64px; letter-spacing: .12em; line-height: 1; margin: 18px 0 10px; }.headline { font-size: 18px; color: #d8edf0; }.contact-grid { display: grid; grid-template-columns: repeat(2, minmax(180px, 1fr)); gap: 9px 28px; margin-top: 28px; color: #d7e6eb; font-size: 13px; }.contact-grid b { color: #8bd6d0; margin-right: 10px; font-weight: 600; }.portrait { width: 114px; height: 148px; border: 1px solid rgba(255,255,255,.5); background: linear-gradient(150deg, #dcebed, #a6c7ce); display: block; overflow: hidden; z-index: 1; box-shadow: 10px 10px 0 rgba(255,255,255,.12); }.portrait img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center top; }
  .content { padding: 38px 58px 54px; }.section { margin-top: 34px; }.section:first-child { margin-top: 0; }.section-heading { display: flex; align-items: center; gap: 16px; color: #142b49; font-size: 18px; font-weight: 800; letter-spacing: .08em; }.section-heading span { white-space: nowrap; }.section-heading i { height: 1px; background: #b8d1d5; flex: 1; position: relative; }.section-heading i:after { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #2b8f91; position: absolute; right: 0; top: -3px; }.education-row { display: flex; justify-content: space-between; margin: 18px 0 8px; color: #2b8f91; font-size: 14px; }.section p, li { color: #526071; font-size: 13px; line-height: 1.8; }.skill-cloud, .tag-row { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 12px; }.skill-cloud span { color: #1b5e6a; background: #e8f5f3; border: 1px solid #cde7e3; border-radius: 99px; padding: 6px 12px; font-size: 12px; }.skill-list { display: grid; gap: 4px; }.skill-list b { color: #213d59; }.project { background: #f5f8fa; border: 1px solid #e1eaed; padding: 22px 24px 25px; border-radius: 12px; }.project .section-heading { margin-bottom: 14px; }.project-meta { display: flex; justify-content: space-between; color: #183c60; font-size: 14px; font-weight: 700; }.tag-row { margin: 14px 0; }.tag-row em { font-style: normal; color: #61707c; font-size: 11px; background: #fff; border: 1px solid #d8e2e6; padding: 4px 8px; border-radius: 4px; }.project-intro { border-left: 3px solid #54aaa5; padding-left: 13px; }.project-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-top: 18px; }.project h3 { font-size: 13px; color: #1b5373; margin-bottom: 7px; }.project ol { margin: 0; padding-left: 20px; }.experience { display: grid; gap: 13px; }.experience .section-heading { margin-bottom: 4px; }.experience-row { display: grid; grid-template-columns: 155px 1fr 130px; gap: 18px; align-items: center; border-bottom: 1px solid #edf1f3; padding: 8px 0; font-size: 13px; }.experience-row strong { color: #2b8f91; }.experience-row span { color: #43536a; }.experience-row b { color: #1d3553; text-align: right; }.evaluation-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 30px; margin-top: 18px; }.evaluation-grid p { color: #2b8f91; font-weight: 800; }.evaluation-grid span { color: #526071; font-weight: 400; margin-left: 9px; }
  .intent-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 40px; margin-top: 16px; }.intent-grid p { color: #526071; font-size: 13px; line-height: 1.8; }.intent-grid b { color: #213d59; }
  @media (max-width: 700px) { .hero { padding: 32px 24px; align-items: flex-start; }.hero h1 { font-size: 48px; }.portrait { width: 78px; height: 104px; font-size: 28px; }.contact-grid { grid-template-columns: 1fr; gap: 7px; }.content { padding: 28px 24px 42px; }.project-columns, .evaluation-grid, .intent-grid { grid-template-columns: 1fr; gap: 16px; }.experience-row { grid-template-columns: 1fr; gap: 3px; }.experience-row b { text-align: left; }.section-heading { font-size: 16px; } }
  @media print { .resume { margin: 0; width: 210mm; box-shadow: none; } .hero { print-color-adjust: exact; -webkit-print-color-adjust: exact; } }
</style>
